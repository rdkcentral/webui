<?% include('includes/jwt.jst') ?>
<?%
$guardianConfigPath = "/var/tmp/guardian.cfg";
$action = isset($_POST['action']) ? strtolower(trim($_POST['action'])) : "";

$response = {};

if ("apply" == $action) {
    $guardianScript = "/var/tmp/guardian.sh";
    $guardianCfg = "/var/tmp/guardian.cfg";
    $guardianResponseLines = [];

    $guardianScriptExists = file_exists($guardianScript);
    $guardianCfgExists = file_exists($guardianCfg);
    $guardianScriptReadable = is_readable($guardianScript);
    $guardianCfgReadable = is_readable($guardianCfg);

/*
    $ifconfigOutput = exec("/sbin/ifconfig brlan0");
    if ($ifconfigOutput && $ifconfigOutput.length > 0) {
        $guardianResponseLines = $guardianResponseLines.concat($ifconfigOutput);
    }
*/

    if ($guardianScriptExists && $guardianCfgExists && $guardianScriptReadable && $guardianCfgReadable) {
        $guardianClearOutput = exec("/bin/bash /var/tmp/guardian.sh /var/tmp/guardian.cfg clear");
        $guardianApplyOutput = exec("/bin/bash /var/tmp/guardian.sh /var/tmp/guardian.cfg apply");

        $guardianResponseLines = $guardianResponseLines.concat($guardianClearOutput);
        $guardianResponseLines = $guardianResponseLines.concat($guardianApplyOutput);
        $response['status'] = ($guardianResponseLines.length > 0) ? "success" : "failure";
    } else {
        $response['status'] = "failure";
        $guardianResponseLines = $guardianResponseLines.concat([
            "guardian script missing: " + $guardianScriptExists,
            "guardian config missing: " + $guardianCfgExists,
            "guardian script readable: " + $guardianScriptReadable,
            "guardian config readable: " + $guardianCfgReadable
        ]);
    }

    $response['message'] = $guardianResponseLines.join("\n");
    if ($guardianResponseLines.length == 0) {
        $response['message'] = "Guardian apply failed";
    }
}
else {
    $configInfo = isset($_POST['configInfo']) ? $_POST['configInfo'] : "";
    $configInfo = str_replace("\r\n", "\n", $configInfo);
    $configInfo = str_replace("\r", "\n", $configInfo);
    $configInfo = str_replace("\0", "", $configInfo);

    if (!file_exists($guardianConfigPath)) {
        $guardianBootstrapFile = fopen($guardianConfigPath, "w");
        if ($guardianBootstrapFile != false) {
            fclose($guardianBootstrapFile);
        }
    }
    $guardianFile = fopen($guardianConfigPath, "w");
    if ($guardianFile != false) {
        fwrite($guardianFile, $configInfo);
        fclose($guardianFile);
        $response['status'] = "success";
    }
}

header("Content-Type: application/json");
echo(htmlspecialchars(json_encode($response), ENT_NOQUOTES, 'UTF-8'));
?>
